# Copy to .env.local for local dev. In production these MUST be set as
# BUILD-TIME environment variables (a static export never reads runtime vars).
# Real values belong in Cloudflare Pages / .env.local only - never in git.

NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Base URL only - the app appends /avatar-iq, /content-maker, /offer-iq.
NEXT_PUBLIC_N8N_WEBHOOK_BASE_URL=https://your-instance.app.n8n.cloud/webhook

# Dev-only /api/n8n proxy. Has no effect in the static production build.
N8N_WEBHOOK_BASE_URL=https://your-instance.app.n8n.cloud/webhook
N8N_MAX_BODY_BYTES=1000000
N8N_REQUEST_TIMEOUT_MS=120000
