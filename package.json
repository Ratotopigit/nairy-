{
  "name": "webinarkit",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "dev:fast": "next dev --turbo",
    "dev:turbo": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "verify:billing": "node scripts/billing-sandbox.mjs",
    "test:emulator": "firebase emulators:exec --config tests/billing/firebase.emulator.json --only firestore --project demo-nairy \"node --test tests/billing/emulator.e2e.mjs\""
  },
  "dependencies": {
    "clsx": "2.1.1",
    "firebase": "^12.18.0",
    "framer-motion": "11.18.2",
    "jszip": "^3.10.2",
    "lucide-react": "0.427.0",
    "next": "^15.5.28",
    "pptxgenjs": "4.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "autoprefixer": "10.5.4",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  }
}
