rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Workspace memory: documents are keyed directly by owner_id (user.uid)
    match /workspace_memory/{ownerId} {
      allow read, write: if isOwner(ownerId);
    }

    // Workspace assets: files metadata owned by user
    match /workspace_assets/{assetId} {
      allow read, delete: if isAuthenticated() && resource.data.owner_id == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.owner_id == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.owner_id == request.auth.uid && request.resource.data.owner_id == request.auth.uid;
    }

    // Blueprint sessions: sessions created by the user
    match /blueprint_sessions/{sessionId} {
      allow read, delete: if isAuthenticated() && resource.data.owner_id == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.owner_id == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.owner_id == request.auth.uid && request.resource.data.owner_id == request.auth.uid;
    }

    // Content sessions: slide decks and content creation sessions
    match /content_sessions/{projectId} {
      allow read, delete: if isAuthenticated() && resource.data.owner_id == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.owner_id == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.owner_id == request.auth.uid && request.resource.data.owner_id == request.auth.uid;
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
