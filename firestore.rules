rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Verify admin privilege: user must be signed in AND have admin == true in database
    function isAdmin() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/workspace_memory/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/workspace_memory/$(request.auth.uid)).data.admin == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true) ||
        (request.auth.token.email != null &&
         exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.admin == true)
      );
    }

    // System Settings (home_content):
    // Public read: ANY user, guest, or member can read home page settings.
    // Authenticated write: Admins can update system settings.
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Dedicated users collection:
    // Auto-populated on login/signup so owner can see all profiles and emails in Firebase Console!
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && 
        (!('admin' in request.resource.data) || request.resource.data.admin != true || isAdmin());
      allow update: if isOwner(userId) && 
        (!('admin' in request.resource.data) || request.resource.data.admin == resource.data.admin || isAdmin());
      allow delete: if isAdmin();
    }

    // Dedicated admins collection (keyed by email):
    // Owner can easily add an email here to grant admin access.
    // Prevent unprivileged users from dumping all admin emails.
    match /admins/{email} {
      allow get: if isAuthenticated() && (request.auth.token.email == email || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Workspace memory: documents are keyed directly by owner_id (user.uid)
    // Regular users can manage their memory, but CANNOT self-escalate admin: true
    match /workspace_memory/{ownerId} {
      allow read: if isOwner(ownerId) || isAdmin();
      allow create: if isOwner(ownerId) && 
        (!('admin' in request.resource.data) || request.resource.data.admin != true || isAdmin());
      allow update: if isOwner(ownerId) && 
        (!('admin' in request.resource.data) || request.resource.data.admin == resource.data.admin || isAdmin());
      allow delete: if isOwner(ownerId) || isAdmin();
    }

    // Workspace assets: files metadata owned by user
    match /workspace_assets/{assetId} {
      allow read, delete: if isAuthenticated() && resource.data.owner_id == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.owner_id == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.owner_id == request.auth.uid && request.resource.data.owner_id == request.auth.uid;
    }

    // Blueprint sessions: sessions created by the user
    match /blueprint_sessions/{sessionId} {
      allow read, delete: if isAuthenticated() && resource.data.owner_id == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.owner_id == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.owner_id == request.auth.uid && request.resource.data.owner_id == request.auth.uid;
    }

    // Chat histories: one document per session UUID
    match /chat_histories/{sessionId} {
      allow read, delete: if isAuthenticated() && resource.data.owner_id == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.owner_id == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.owner_id == request.auth.uid && request.resource.data.owner_id == request.auth.uid;
    }

    // Content sessions: slide decks and content creation sessions
    match /content_sessions/{projectId} {
      allow read, delete: if isAuthenticated() && resource.data.owner_id == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.owner_id == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.owner_id == request.auth.uid && request.resource.data.owner_id == request.auth.uid;
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
